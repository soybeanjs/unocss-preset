{
  "name": "@soybeanjs/unocss-preset",
  "version": "0.2.0",
  "description": "soybeanjs's unocss preset",
  "homepage": "https://github.com/soybeanjs/unocss-preset",
  "bugs": {
    "url": "https://github.com/soybeanjs/unocss-preset/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/unocss-preset.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "commit": "soy git-commit",
    "fmt": "vp fmt",
    "lint": "vp lint . --fix",
    "prepare": "vp config --no-agent",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "unocss": "^66.11.0"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
